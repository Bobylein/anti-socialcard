{
  "name": "anti-socialcard-de",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run update && node scripts/prepare-deploy.mjs",
    "deploy": "npm run build && wrangler deploy",
    "dev": "npm run build && wrangler dev",
    "test": "node --test && node scripts/check-generated-script.mjs",
    "update": "node scripts/update-site.mjs",
    "serve": "python3 -m http.server 4173"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
